# Required only for a normal `watch` run or `test-telegram`.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id

# Optional settings (the defaults are deliberately conservative).
REQUEST_TIMEOUT_SECONDS=15
REQUEST_RETRIES=3
REQUEST_DELAY_SECONDS=1.5
STATE_FILE=data/state.json
LOG_LEVEL=INFO
